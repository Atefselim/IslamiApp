<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:background="@color/black">
    <TextView
        android:id="@+id/sura_number_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/sura_number_bg"
        tools:text="1"
        android:gravity="center"
        android:textColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="8dp"
        />
    <TextView
        android:id="@+id/sura_title_en_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Alfatiha"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/number_of_verses"
        app:layout_constraintStart_toEndOf="@id/sura_number_tv"
        android:textColor="@color/white"
        android:textSize="20sp"


        />
    <TextView
        android:id="@+id/number_of_verses"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="7 verses"
        android:textColor="@color/white"
        app:layout_constraintBottom_toTopOf="@id/chapter_divider_view"
        app:layout_constraintStart_toEndOf="@id/sura_number_tv"
        app:layout_constraintTop_toBottomOf="@id/sura_title_en_tv"

        />

    <View
        android:id="@+id/chapter_divider_view"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintTop_toBottomOf="@id/sura_number_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="4dp"
        android:layout_marginTop="6dp"
        app:layout_constraintWidth_percent=".8"

        />
    <TextView
        android:id="@+id/sura_title_ar_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="الفاتحه"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/chapter_divider_view"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@id/sura_title_en_tv"
        app:layout_constraintHorizontal_bias=".9"
        />



</androidx.constraintlayout.widget.ConstraintLayout>